<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="YoloDotNet" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Models\plate_rtdetr.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Models\th_pp-ocrv5_mobile_rec.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Models\ppocrv5_th_dict.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DownloadOnnxModels" BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT' And (!Exists('$(MSBuildProjectDirectory)\Models\plate_rtdetr.onnx') Or !Exists('$(MSBuildProjectDirectory)\Models\th_pp-ocrv5_mobile_rec.onnx'))">
    <Message Importance="high" Text="Downloading ONNX models into Models/ ..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\download-models.ps1&quot;" />
  </Target>

</Project>
