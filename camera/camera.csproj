<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <StartupObject>ConsoleApp1.Program</StartupObject>
    <DefaultLaunchProfileName>Live (IP camera)</DefaultLaunchProfileName>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="YoloDotNet" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DownloadOnnxModels" BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_NeedOnnx Condition="!Exists('$(MSBuildProjectDirectory)\Models\plate_rtdetr.onnx') Or !Exists('$(MSBuildProjectDirectory)\Models\th_pp-ocrv5_mobile_rec.onnx')">true</_NeedOnnx>
      <_DownloadScript>$(MSBuildProjectDirectory)\..\download-models.ps1</_DownloadScript>
      <_DownloadScript Condition="!Exists('$(_DownloadScript)')">$(MSBuildProjectDirectory)\download-models.ps1</_DownloadScript>
    </PropertyGroup>
    <Message Condition="'$(_NeedOnnx)' == 'true'" Importance="high" Text="Downloading ONNX models into Models/ ..." />
    <Exec Condition="'$(_NeedOnnx)' == 'true' And Exists('$(_DownloadScript)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_DownloadScript)&quot;" />
  </Target>

  <Target Name="CopyModelsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_LocalModelFiles Include="$(MSBuildProjectDirectory)\Models\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Models" />
    <Copy SourceFiles="@(_LocalModelFiles)"
          DestinationFolder="$(TargetDir)Models"
          SkipUnchangedFiles="true"
          Condition="'@(_LocalModelFiles)' != ''" />
  </Target>

</Project>
